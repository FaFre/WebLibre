<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window attributes shared by LaunchTheme and NormalTheme. The system bars are
         transparent over the theme background, as MainActivity sets them once it
         starts (enableTransparentSystemBars). The launch theme also styles the window
         Android shows before that, the splash screen on Android 12+, whose
         navigation bar would otherwise be the platform's black (#651). Icon
         brightness follows the system theme: the app's own theme isn't known yet. -->
    <style name="WindowTheme" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <!-- Required by Mozilla Components (e.g. the add-on permission dialog's
             message bars, mozac_feature_addons_message_bars.xml) wherever it's
             inflated over this theme; unset it throws UnsupportedOperationException. -->
        <item name="mozac_primary_text_color">?attr/colorOnSurface</item>
    </style>

    <!-- Theme applied to the Android Window while the process is starting. -->
    <style name="LaunchTheme" parent="WindowTheme" />

    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="WindowTheme" />

    <style name="Widget.WebLibreWidget.AppWidget.Container" parent="android:Widget">
        <item name="android:id">@android:id/background</item>
        <item name="android:background">?android:attr/colorBackground</item>
    </style>

    <style name="Widget.WebLibreWidget.AppWidget.InnerView" parent="android:Widget">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="AppTheme" parent="Theme.Material3.DynamicColors.DayNight">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="ExternalAppBrowserTheme" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- See WindowTheme above. -->
        <item name="mozac_primary_text_color">?attr/colorOnSurface</item>
    </style>
</resources>
