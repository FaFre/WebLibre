{
  "@@locale": "en",

  "webSearch_fetchPageDataTitle": "Fetch Page Data",
  "@webSearch_fetchPageDataTitle": {
    "description": "Title of the dialog for choosing how to fetch a web search result page through the privacy-preserving server (as a text preview, full copy, PDF or image)."
  },
  "webSearch_downloadFailedTapToRetry": "Download failed — tap to retry",
  "@webSearch_downloadFailedTapToRetry": {
    "description": "Error line in the fetch dialog when downloading a server-captured page failed; tapping retries."
  },

  "webSearch_methodTrafilaturaTitle": "Extracted Preview",
  "@webSearch_methodTrafilaturaTitle": {
    "description": "Fetch method: a text-only preview of the page extracted on the server."
  },
  "webSearch_methodSinglefileTitle": "Full Page Capture",
  "@webSearch_methodSinglefileTitle": {
    "description": "Fetch method: a complete copy of the page including layout and images, saved as one file."
  },
  "webSearch_methodPdfTitle": "PDF Snapshot",
  "@webSearch_methodPdfTitle": {
    "description": "Fetch method: a PDF file of the rendered page."
  },
  "webSearch_methodPngTitle": "Image Snapshot",
  "@webSearch_methodPngTitle": {
    "description": "Fetch method: a picture (PNG screenshot) of the whole rendered page."
  },
  "webSearch_methodTrafilaturaSubtitle": "Reader-optimized text and metadata for the in-app preview",
  "@webSearch_methodTrafilaturaSubtitle": {
    "description": "Explanation under \"Extracted Preview\"."
  },
  "webSearch_methodSinglefileSubtitle": "Archive the full page with layout and assets for later use",
  "@webSearch_methodSinglefileSubtitle": {
    "description": "Explanation under \"Full Page Capture\". \"Assets\" are the page's images, styles and similar files."
  },
  "webSearch_methodPdfSubtitle": "Render the page to a PDF for offline reading and sharing",
  "@webSearch_methodPdfSubtitle": {
    "description": "Explanation under \"PDF Snapshot\"."
  },
  "webSearch_methodPngSubtitle": "Capture a full-page PNG screenshot of the rendered page",
  "@webSearch_methodPngSubtitle": {
    "description": "Explanation under \"Image Snapshot\". PNG is an image file format."
  },

  "webSearch_previewUnavailableTitle": "Preview unavailable",
  "@webSearch_previewUnavailableTitle": {
    "description": "Error heading when opening a preview of a search result that was not fetched yet."
  },
  "webSearch_previewUnavailableMessage": "Fetch the page from the result list before opening a preview.",
  "@webSearch_previewUnavailableMessage": {
    "description": "Explanation under \"Preview unavailable\": the page must first be fetched with the button in the search results."
  },
  "webSearch_openInBrowserTooltip": "Open in browser",
  "@webSearch_openInBrowserTooltip": {
    "description": "Tooltip of the button on the page preview screen that opens the original page in a browser tab."
  },

  "webSearch_torToggleOn": "{brand} on",
  "@webSearch_torToggleOn": {
    "description": "Label of the web search toggle while searches are routed through Tor. brand is \"Tor™\".",
    "placeholders": { "brand": { "type": "String" } }
  },
  "webSearch_torToggleOff": "{brand} off",
  "@webSearch_torToggleOff": {
    "description": "Label of the web search toggle while searches are not routed through Tor. brand is \"Tor™\".",
    "placeholders": { "brand": { "type": "String" } }
  },

  "webSearch_languageAuto": "Auto",
  "@webSearch_languageAuto": {
    "description": "Label of the search language filter button when no language is chosen (automatic)."
  },
  "webSearch_languageAutoDeviceDefault": "Auto (device default)",
  "@webSearch_languageAutoDeviceDefault": {
    "description": "Choice in the search language filter menu: pick the language automatically from the device settings."
  },
  "webSearch_countryAny": "Any",
  "@webSearch_countryAny": {
    "description": "Label of the search region filter button when no region is chosen."
  },
  "webSearch_countryAnyRegion": "Any region",
  "@webSearch_countryAnyRegion": {
    "description": "Choice in the search region filter menu: results from any country."
  },
  "webSearch_countryDeviceDefault": "{name} (device)",
  "@webSearch_countryDeviceDefault": {
    "description": "Choice in the search region filter menu for the device's own country. name is the country name.",
    "placeholders": { "name": { "type": "String" } }
  },
