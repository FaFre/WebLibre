    "description": "Choice in the SafeSearch menu: use the default level, which is moderate."
  },
  "webSearch_safeSearchMenuOff": "Off",
  "@webSearch_safeSearchMenuOff": {
    "description": "Choice in the SafeSearch menu: do not filter explicit content."
  },
  "webSearch_safeSearchMenuModerate": "Moderate",
  "@webSearch_safeSearchMenuModerate": {
    "description": "Choice in the SafeSearch menu: moderate filtering of explicit content."
  },
  "webSearch_safeSearchMenuStrict": "Strict",
  "@webSearch_safeSearchMenuStrict": {
    "description": "Choice in the SafeSearch menu: strict filtering of explicit content."
  },
  "webSearch_freshnessAnyTime": "Any time",
  "@webSearch_freshnessAnyTime": {
    "description": "Label and choice of the search date filter: results of any age."
  },
  "webSearch_freshnessPastDay": "Past day",
