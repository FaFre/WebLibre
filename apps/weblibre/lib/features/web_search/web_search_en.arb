    "description": "Label and choice of the search date filter: only results from the last 24 hours."
  },
  "webSearch_freshnessPastWeek": "Past week",
  "@webSearch_freshnessPastWeek": {
    "description": "Label and choice of the search date filter: only results from the last 7 days."
  },
  "webSearch_freshnessPastMonth": "Past month",
  "@webSearch_freshnessPastMonth": {
    "description": "Label and choice of the search date filter: only results from the last month."
  },
  "webSearch_freshnessPastYear": "Past year",
  "@webSearch_freshnessPastYear": {
    "description": "Label and choice of the search date filter: only results from the last year."
  },

  "webSearch_modeGeneralLabel": "General",
  "@webSearch_modeGeneralLabel": {
    "description": "Web search mode: normal search across the whole web."
  },
  "webSearch_modeIndependentWebLabel": "Independent Web",
  "@webSearch_modeIndependentWebLabel": {
    "description": "Web search mode that prefers independent websites over large corporate ones."
  },
  "webSearch_modeSmallWebLabel": "Small Web",
  "@webSearch_modeSmallWebLabel": {
    "description": "Web search mode limited to the \"small web\": personal and non-commercial websites. Keep \"Small Web\" consistent with the app's Small Web feature."
  },
  "webSearch_modeGeneralDescription": "Balanced results across the open web",
  "@webSearch_modeGeneralDescription": {
    "description": "Explanation under the \"General\" search mode."
  },
  "webSearch_modeIndependentWebDescription": "Favor smaller and less corporate sources",
  "@webSearch_modeIndependentWebDescription": {
    "description": "Explanation under the \"Independent Web\" search mode."
  },
  "webSearch_modeSmallWebDescription": "Independent, personal & niche sites",
  "@webSearch_modeSmallWebDescription": {
    "description": "Explanation under the \"Small Web\" search mode."
  },

  "webSearch_fetchTooltip": "Fetch",
  "@webSearch_fetchTooltip": {
    "description": "Tooltip of the download button on a search result that fetches the page through the privacy-preserving server."
  },

  "webSearch_additionalSnippetsHeading": "Additional Snippets",
  "@webSearch_additionalSnippetsHeading": {
    "description": "Heading above extra text excerpts from the page, shown when a search result is expanded."
  },
  "webSearch_questionPrefix": "Q: ",
  "@webSearch_questionPrefix": {
    "description": "Prefix in front of a question in a search result's excerpts (\"Q\" for question). Keep the trailing space."
  },
  "webSearch_snippetsTooltip": "Snippets",
  "@webSearch_snippetsTooltip": {
    "description": "Tooltip of the button that expands a search result to show more text excerpts from the page."
  },
  "webSearch_showMoreLinks": "{count, plural, =1{Show 1 more link} other{Show {count} more links}}",
  "@webSearch_showMoreLinks": {
    "description": "Button in a search info box that reveals hidden links. count is the number of hidden links.",
    "placeholders": { "count": { "type": "int" } }
  },

  "webSearch_factsheetHeading": "Factsheet",
  "@webSearch_factsheetHeading": {
    "description": "Heading of the section in a search info box that lists key facts about the topic (like an encyclopedia fact box)."
  },

  "webSearch_searchFailedTitle": "Search failed",
  "@webSearch_searchFailedTitle": {
    "description": "Error heading when a web search failed; the error message follows below."
  },
  "webSearch_searchingLabel": "Searching the web...",
  "@webSearch_searchingLabel": {
    "description": "Progress text while a web search runs."
  },
  "webSearch_noResultsFor": "No results found for \"{query}\".",
  "@webSearch_noResultsFor": {
    "description": "Shown when a web search returned nothing. query is the search text.",
    "placeholders": { "query": { "type": "String" } }
  },
  "webSearch_creditsTokensStatus": "{credits, plural, =1{1 credit} other{{credits} credits}}  |  {tokens, plural, =1{1 token} other{{tokens} tokens}}",
  "@webSearch_creditsTokensStatus": {
    "description": "Status line above web search results. credits is the remaining prepaid search credits; tokens is the number of anonymous search tokens stored on the device. Keep the \"|\" separator.",
    "placeholders": {
      "credits": { "type": "int" },
      "tokens": { "type": "int" }
    }
  },
  "webSearch_needsCreditsMessage": "No search credits or tokens are available for a new web search.",
  "@webSearch_needsCreditsMessage": {
    "description": "Shown instead of results when the user has no search credits or tokens left for a web search."
  },
  "webSearch_buySearchPackButton": "Buy a search pack",
  "@webSearch_buySearchPackButton": {
    "description": "Button under that message that opens the store page for buying search credits."
  },

  "webSearch_socketConnectionError": "Search connection error. Please try again.",
  "@webSearch_socketConnectionError": {
    "description": "Error message when the connection to the search server failed."
  },
  "webSearch_closeErrorSessionTimeout": "Search session timed out. Please try again.",
  "@webSearch_closeErrorSessionTimeout": {
    "description": "Error message when the search server ended the session because it took too long."
  },
  "webSearch_closeErrorCreditInvalid": "Your search credit could not be validated. The credit may have been spent — please try again.",
  "@webSearch_closeErrorCreditInvalid": {
    "description": "Error message when the search server rejected the search credit (it may already have been used)."
  },
  "webSearch_closeErrorPolicyForbidden": "The requested page is not permitted by the search policy.",
  "@webSearch_closeErrorPolicyForbidden": {
    "description": "Error message when the search server refused to fetch a page because its rules do not allow that site."
  },
  "webSearch_closeErrorServerFailed": "The search failed on the server. Please try again.",
  "@webSearch_closeErrorServerFailed": {
    "description": "Error message when the search server reported an internal failure."
  },
  "webSearch_closeErrorUnknown": "Search connection closed unexpectedly (code {code}). Please try again.",
  "@webSearch_closeErrorUnknown": {
    "description": "Error message when the search server closed the connection for an unknown reason. code is the numeric close code.",
    "placeholders": { "code": { "type": "int" } }
  },

  "webSearch_unknownErrorDetail": "unknown error",
  "@webSearch_unknownErrorDetail": {
    "description": "Fallback detail inserted into the \"({detail})\" part of search error messages when the server gave none. Lowercase fragment, not a sentence."
  },
  "webSearch_streamErrorProtocol": "Search protocol error. The session has ended — please try again. ({detail})",
  "@webSearch_streamErrorProtocol": {
    "description": "Error message when the app and search server disagreed about the data format. detail is the server's reason (often English) or \"unknown error\".",
    "placeholders": { "detail": { "type": "String" } }
  },
  "webSearch_streamErrorSearchFailed": "The search failed on the server. Please try again. ({detail})",
  "@webSearch_streamErrorSearchFailed": {
    "description": "Error message when the search failed on the server. detail is the server's reason (often English) or \"unknown error\".",
    "placeholders": { "detail": { "type": "String" } }
  },
  "webSearch_streamErrorFetchFailed": "Could not fetch this page from the source. ({detail})",
  "@webSearch_streamErrorFetchFailed": {
    "description": "Error message when the server could not download a result page from its website. detail is the server's reason (often English) or \"unknown error\".",
    "placeholders": { "detail": { "type": "String" } }
  },
  "webSearch_streamErrorExtractFailed": "Could not extract a readable preview from this page. ({detail})",
  "@webSearch_streamErrorExtractFailed": {
    "description": "Error message when the server could not produce a text preview of a result page. detail is the server's reason (often English) or \"unknown error\".",
    "placeholders": { "detail": { "type": "String" } }
  },
  "webSearch_streamErrorNotAllowed": "This page is not permitted by the search policy. ({detail})",
  "@webSearch_streamErrorNotAllowed": {
    "description": "Error message when the server's rules do not allow fetching this page. detail is the server's reason (often English) or \"unknown error\".",
    "placeholders": { "detail": { "type": "String" } }
  },
  "webSearch_streamErrorCaptureFailed": "Page capture failed. ({detail})",
  "@webSearch_streamErrorCaptureFailed": {
    "description": "Error message when the server failed to capture a result page as a file. detail is the server's reason (often English) or \"unknown error\".",
    "placeholders": { "detail": { "type": "String" } }
  },
  "webSearch_streamErrorGeneric": "Search error: {detail}",
  "@webSearch_streamErrorGeneric": {
    "description": "Error message for any other search failure. detail is the server's reason (often English) or \"unknown error\".",
    "placeholders": { "detail": { "type": "String" } }
  },

  "webSearch_torStartFailed": "Could not start {torBrand} for the search. Disable the {torBrand} toggle or try again.",
  "@webSearch_torStartFailed": {
    "description": "Error message when a web search should go through Tor but Tor could not be started. torBrand is \"Tor™\" and appears twice.",
    "placeholders": { "torBrand": { "type": "String" } }
  },
  "webSearch_creditCheckFailed": "Could not check search credits. Please try again.",
  "@webSearch_creditCheckFailed": {
    "description": "Error message when the app could not check the user's search credit balance before searching."
  },
  "webSearch_tokenIssuanceFailed": "Could not issue search tokens. Please try again.",
  "@webSearch_tokenIssuanceFailed": {
    "description": "Error message when the app could not obtain the anonymous search tokens needed for a web search."
  }
}
