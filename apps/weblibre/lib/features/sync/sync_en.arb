{
  "@@locale": "en",

  "sync_screenTitle": "Firefox Sync",
  "@sync_screenTitle": {
    "description": "Title of the settings screen for Firefox Sync, Mozilla's service for syncing bookmarks, history and tabs between devices. Product name; usually left untranslated."
  },
  "sync_searchHint": "Search sync settings",
  "@sync_searchHint": {
    "description": "Placeholder of the search field on the Firefox Sync settings screen."
  },

