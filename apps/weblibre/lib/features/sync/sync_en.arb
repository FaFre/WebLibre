  "sync_fxaServerOverrideTitle": "FxA Server Override",
  "@sync_fxaServerOverrideTitle": {
    "description": "Row and dialog title for a custom Firefox Account sign-in server address. FxA is Mozilla's abbreviation for Firefox Account."
  },
  "sync_defaultMozillaServer": "Default Mozilla server",
  "@sync_defaultMozillaServer": {
    "description": "Shown under the account server row when no custom server is set, meaning Mozilla's own server is used."
  },
  "sync_tokenServerOverrideTitle": "Sync Token Server Override",
  "@sync_tokenServerOverrideTitle": {
    "description": "Row and dialog title for a custom Firefox Sync token server address (the server that hands out access to sync storage)."
  },
  "sync_automaticFromFxaServer": "Automatic from FxA server",
  "@sync_automaticFromFxaServer": {
    "description": "Shown under the token server row when no custom server is set: the address is taken from the Firefox Account server's configuration. FxA is Mozilla's abbreviation for Firefox Account."
  },
  "sync_restartAppNotice": "Restart the app after changing server overrides.",
  "@sync_restartAppNotice": {
    "description": "Small note under the server override rows: changes only take effect after restarting the app."
  },

  "sync_signOutDialogTitle": "Sign out?",
  "@sync_signOutDialogTitle": {
    "description": "Title of the confirmation dialog before signing out of Firefox Sync."
  },
  "sync_signOutDialogContent": "Are you sure you want to sign out of Firefox Sync?",
