    "description": "Line under the account row when not signed in, inviting the user to sign in."
  },
  "sync_actionSignOut": "Sign Out",
  "@sync_actionSignOut": {
    "description": "Tooltip of the sign-out button on the account row, and confirm button of the sign-out dialog."
  },

