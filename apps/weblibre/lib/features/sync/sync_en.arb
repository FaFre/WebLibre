    "description": "Body of the confirmation dialog before signing out of Firefox Sync."
  },

  "sync_deviceNameHint": "Enter device name",
  "@sync_deviceNameHint": {
    "description": "Placeholder of the text field in the device name dialog."
  },
  "sync_deviceNameEmpty": "Device name cannot be empty",
  "@sync_deviceNameEmpty": {
    "description": "Error message when saving an empty device name."
  },
  "sync_deviceNameUpdateFailed": "Failed to update device name",
  "@sync_deviceNameUpdateFailed": {
    "description": "Error message when the new device name could not be saved to Firefox Sync."
  },
  "sync_mustBeValidHttpsUrl": "Must be a valid HTTPS URL",
  "@sync_mustBeValidHttpsUrl": {
    "description": "Error message when a custom sync server address is not a valid web address starting with https."
