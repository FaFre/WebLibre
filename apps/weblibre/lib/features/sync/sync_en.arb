    "description": "Title of the settings entry for custom Firefox Sync servers."
  },
  "sync_entryServerOverridesKeywords": "fxa, token server",
  "@sync_entryServerOverridesKeywords": {
    "description": "Comma-separated search terms for this setting. Not displayed; include synonyms users might type."
