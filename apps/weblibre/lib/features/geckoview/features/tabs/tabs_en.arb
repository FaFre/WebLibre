    "description": "Short message at the bottom of the screen when deleting a container stopped because some of its tabs stayed open. The container and those tabs are still there; deleting it again tries again."
  },
  "tabs_deleteContainerNotPersisted": "The container was not deleted because its frozen state could not be saved. Try again.",
  "@tabs_deleteContainerNotPersisted": {
    "description": "Short message at the bottom of the screen when deleting a frozen container stopped before anything was deleted, because the app could not save that the deletion had started (for example, the storage is full). A frozen container's background activity is stopped until it is resumed. The container is still there; deleting it again tries again."
  },
  "tabs_deleteContainerFreezeStateUnknown": "The container was not deleted because WebLibre could not check whether it is frozen. Try again.",
  "@tabs_deleteContainerFreezeStateUnknown": {
    "description": "Short message at the bottom of the screen when deleting a container stopped before anything was closed or deleted, because WebLibre could not read its record of which containers are frozen (\"Freeze\" stops a container's background activity until it is resumed). Without it, the app does not know which site data belongs to the container. The container is still there; deleting it again tries again."
  },
  "tabs_deleteContainerSiteDataPending": "Container deleted; site-data cleanup pending",
  "@tabs_deleteContainerSiteDataPending": {
    "description": "Short message at the bottom of the screen after a frozen container was deleted but its site data (cookies, sign-ins, offline data, notification subscriptions) could not be deleted yet. That data stays blocked from running and the app tries again at every start."
  },
  "tabs_deleteContainerOpenInWebApp": "Close this container's web apps and custom tabs first",
  "@tabs_deleteContainerOpenInWebApp": {
    "description": "Short message at the bottom of the screen when deleting a container was refused because a web app (an installed site opened in its own window) or a custom tab (a link from another app opened in a WebLibre window) still runs in the container. Nothing was closed or deleted; the user closes those windows and deletes the container again."
  },
  "tabs_deleteContainerSharedStorage": "An isolated tab of another container uses this frozen container's storage. Resume the container before deleting it.",
  "@tabs_deleteContainerSharedStorage": {
    "description": "Short message at the bottom of the screen when deleting a frozen container was refused (\"Freeze\" stops a container's background activity until it is resumed). After WebLibre found its record of frozen containers damaged, storage that isolated tabs of two containers share was put under this container only; deleting it would delete that storage's site data while the other container's tab still uses it. Nothing was closed or deleted; once the container is resumed, deleting it leaves that storage to the other tab."
  },
  "tabs_deleteContainerBusy": "This container is still being changed. Try again in a moment.",
  "@tabs_deleteContainerBusy": {
    "description": "Short message at the bottom of the screen when deleting a container could not start: it is already being deleted, or a tab is being added to it or moved in or out of it right now. Nothing was deleted."
  },
  "tabs_deleteContainerRecoveryPending": "No container can be deleted while frozen containers are being restored",
  "@tabs_deleteContainerRecoveryPending": {
    "description": "Short message at the bottom of the screen when deleting a container was refused because WebLibre found its record of frozen containers damaged and is still restoring which containers are frozen. Until then every container is treated as frozen, and its site data could not be deleted reliably. Nothing was deleted; the Containers screen shows how restoring goes."
  },
  "tabs_deleteContainerHistoryFailed": "The container was deleted, but its history could not be deleted",
