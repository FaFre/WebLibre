{
  "manifest_version": 2,
  "name": "WebLibre Fingerprint Shield",
  "version": "1.0",
  "description": "Comprehensive per-origin fingerprint spoofing: UA, screen, canvas, WebGL, audio, fonts, timezone, WebRTC and more, all derived from a single deterministic seed so every surface — including the outgoing User-Agent header — stays mutually consistent.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fingerprint-shield@weblibre.eu"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "permissions": [
    "geckoViewAddons",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "weblibre_protection": {
    "parameters": [
      "userAgent",
      "platform",
      "language",
      "screen",
      "devicePixelRatio",
      "hardwareConcurrency",
      "deviceMemory",
      "timezone",
      "canvas",
      "webgl",
      "audio",
      "webRTC",
      "fonts",
      "battery"
    ],
    "profile": "android-chrome"
  }
}
