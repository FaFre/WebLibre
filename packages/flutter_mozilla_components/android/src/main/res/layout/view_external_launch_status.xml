<!-- What a Custom Tab / PWA window shows while the app half it needs is still
   - coming up, and what it shows instead if that never happens. The window is
   - opened before the wait rather than after it so the launch has somewhere
   - visible to happen: the alternative is a blank launcher for as long as it
   - takes, and then a browser the user never asked for.
   -
   - Everything scrolls and every button is its own full-width row, because this
   - screen is read at whatever font size the user browses at and the failure
   - copy is three lines of it. A centred column that cannot scroll puts the
   - buttons off the bottom of a small screen at the exact moment the user needs
   - one of them. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="?attr/actionBarSize"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/launch_status_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/weblibre_launch_progress_description"
            android:indeterminate="true" />

        <ImageView
            android:id="@+id/launch_status_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/weblibre_ic_launch_problem"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/launch_status_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Connecting privately" />

        <TextView
            android:id="@+id/launch_status_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="“example.com” goes through a proxy that only WebLibre can start." />

        <!-- The step the start-up has actually reached, so a wait that is
           - working looks different from one that is stuck. A live region: it
           - changes while the user is looking at nothing else. -->
        <TextView
            android:id="@+id/launch_status_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:text="Starting the browser engine…"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/launch_status_primary"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minHeight="48dp"
            android:visibility="gone"
            tools:text="Try again"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/launch_status_secondary"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            tools:text="Open in browser" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/launch_status_tertiary"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:visibility="gone"
            tools:text="Close"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>
